# =====================================================================
# Technoflow CRM - environment variables
#
# This file is a TEMPLATE and is safe to commit. It contains no real secrets.
#
# - On your laptop (development): you do not need a .env file at all.
#   python manage.py runserver uses SQLite and safe development defaults.
# - On Render: you do NOT create a .env file. Render takes these values from
#   render.yaml and from what you type in the Render dashboard.
# - On your own Linux server: copy this file to .env, fill it in, and never
#   commit .env (it is listed in .gitignore).
# =====================================================================

# ---- required in production ---------------------------------------------
# Which settings file to use. Render: set in render.yaml.
DJANGO_SETTINGS_MODULE=config.settings.prod

# Long random secret. Render: generated automatically.
# Elsewhere: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# PostgreSQL connection. Render: filled in automatically from the database.
DATABASE_URL=postgres://technoflow:CHANGE_ME@localhost:5432/technoflow_crm

DEBUG=False

# Web address(es) of the CRM, comma separated. Render: the onrender.com address is added
# automatically; add your own domain here only if you connect one.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# ---- first System Administrator (used once, by build.sh) -----------------
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
# Temporary: must be changed at first sign-in. 10+ characters, not common, not only digits.
ADMIN_TEMP_PASSWORD=

# ---- optional --------------------------------------------------------------
# Path of Django's technical admin (letters, digits, - and _ only).
ADMIN_URL=change-this-admin-path
# Public address of the CRM, used for links in notification emails.
SITE_URL=https://crm.technoflow.com
# Password for the demo.director / demo.accounts / demo.engineer / demo.coordinator logins.
# Leave empty to create no demo users.
DEMO_USERS_PASSWORD=
# true = also load fictional demo customers, quotations, orders and invoices (needs DEMO_USERS_PASSWORD).
# Never set this on the real production system.
LOAD_DEMO_DATA=false
TIME_ZONE=Asia/Dubai
DB_CONN_MAX_AGE=60

# Files and logs (own server only; Render's disk is temporary)
MEDIA_ROOT=/var/lib/technoflow_crm/media
LOG_DIR=/var/log/technoflow_crm
MAX_UPLOAD_MB=20

# Security
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
SESSION_IDLE_MINUTES=60
# True only behind your own Nginx reverse proxy (Render: set automatically)
TRUST_X_FORWARDED_FOR=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Email for password-reset links (leave EMAIL_HOST empty to print emails to the log)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=crm@technoflow.com
